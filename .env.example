# GodFather Bot — Umgebungsvariablen
# Kopiere diese Datei zu .env und füll die Werte aus

# ── Pflichtfelder ─────────────────────────────────────────────────────────────

# Telegram Bot Token (von @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Anthropic Claude API Key (optional, für /ask & /prompt)
# CLAUDE_API_KEY=dein_claude_api_key_hier

# Deine Telegram User-ID(s) als Bot-Owner/Admin (komma-separiert)
# Herausfinden: schreib @userinfobot in Telegram
ADMIN_IDS=41050886

# ── Optionale Einstellungen ───────────────────────────────────────────────────

# Welcome-Nachrichten bei neuen Membern (true/false)
WELCOME_ENABLED=true

# Anti-Spam (Links für neue Member blockieren)
ANTISPAM_ENABLED=true

# Max Verwarnungen bis Auto-Ban
MAX_WARNS=3

# Claude Modell
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=500

# SQLite Datenbank-Pfad
DB_PATH=data/godfather.db

# ── DJ-Agent (Navidrome) ─────────────────────────────────────────────────
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=dein_username
NAVIDROME_PASS=dein_passwort

# ── Community Links ───────────────────────────────────────────────────────────
DISCORD_LINK=https://discord.gg/dein_server
WEBSITE_URL=https://lifeplay.dev
GITHUB_URL=https://github.com/lifeplay/godfather-bot
