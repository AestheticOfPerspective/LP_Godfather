# GodFather Bot — Umgebungsvariablen
# Kopiere diese Datei zu .env und füll die Werte aus

# ── Pflichtfelder ─────────────────────────────────────────────────────────────

# Telegram Bot Token (von @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API Key (optional, legacy support)
# CLAUDE_API_KEY=dein_claude_api_key_hier
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_MAX_TOKENS=500


# SQLite Datenbank-Pfad
DB_PATH=data/godfather.db

# ── DJ-Agent (Navidrome) ─────────────────────────────────────────────────
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=dein_username
NAVIDROME_PASS=dein_passwort

# ── Runtime Mode ──────────────────────────────────────────────────────────────
# BOT_MODE=telegram      # telegram | twitch

# ── Twitch (nur für BOT_MODE=twitch) ──────────────────────────────────────────
# Empfehlung: separaten Bot-Account nutzen und im Channel zum Mod machen
# TWITCH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWITCH_CLIENT_ID=your_client_id
# TWITCH_CLIENT_SECRET=your_client_secret
# TWITCH_CHANNEL=your_main_channel
# TWITCH_BOT_NICK=your_secondary_bot_account
# TWITCH_BOT_ID=0
# TWITCH_OWNER=your_main_owner_account
# TWITCH_ADMIN_USERS=trusted_mod1,trusted_mod2

# ── Stream Utility (Telegram / Twitch Commands) ───────────────────────────────
# STREAM_BRAND=JutsuGaming powered by Live.Play
# STREAM_TIMEZONE=Europe/Berlin
# STREAM_SCHEDULE=mi 19:30 Cyberpunk Night City; fr 19:30 Horror Night; so 18:00 Retro ROM Hacks
# STREAM_TODAY_FALLBACK=Heute ist kein fixer Stream eingetragen. Spontan kann immer Magie passieren — follow fuer Ping.
# TWITCH_CHANNEL_URL=https://twitch.tv/jutsugaming
# YOUTUBE_URL=https://youtube.com/@jutsugaming
# CLIP_INTAKE_URL=Poste deinen Twitch-Clip-Link in die Live.Play Gruppe.

# ── Command Cooldowns (Sekunden) ──────────────────────────────────────────────
# COOLDOWN_DEFAULT=3
# COOLDOWN_MOD=1
# COOLDOWN_AI=10
# COOLDOWN_VIBE=30

# ── Telegram Tone / FSK Maturity ─────────────────────────────────────────────
# Available FSK levels: 0, 6, 12, 16, 18, 21
# Default for unknown Telegram chats / DMs
# TELEGRAM_DEFAULT_FSK=12
# Per group title marker: title=level, comma-separated
# TELEGRAM_CHAT_FSK=Live.Play=18,Aesthetic Of Perspective=18

# ── Hermes Primary Router (Telegram-First) ───────────────────────────────────
# HERMES_ROUTER_ENABLED=true
# HERMES_ROUTER_URL=http://127.0.0.1:8088/route
# HERMES_ROUTER_TOKEN=replace_me
# HERMES_ROUTER_TIMEOUT=8
# HERMES_ALLOWED_CHAT_IDS=-1001234567890,123456789
# HERMES_ALLOWED_CHAT_TITLES=Aesthetic Of Perspective,LivePlay
# HERMES_DEFAULT_PHASE=prep
# HERMES_DEFAULT_DJ_MODE=cyber-zen

# ── Nyx.exe Co-DJ / Mixxx Bridge ───────────────────────────────────────────────
# MIXXX_BRIDGE_URL=http://localhost:5002
# MIXXX_POLL_INTERVAL=5.0
# NYX_COMMENTARY_ENABLED=true
# NYX_COMMENTARY_INTERVAL=30
# NYX_COMMENTARY_LLM=false

# ── Community Links ───────────────────────────────────────────────────────────
DISCORD_LINK=https://discord.gg/dein_server
WEBSITE_URL=https://lifeplay.dev
GITHUB_URL=https://github.com/AestheticOfPerspective/LP_Godfather
AMAZON_PARTNER_TAG=dein-tag-21
TWITCH_CHANNEL_URL=https://twitch.tv/jutsugaming
YOUTUBE_URL=https://youtube.com/@jutsugaming
