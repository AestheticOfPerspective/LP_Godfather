# LP_GodFather v4 — .env example
# Copy to .env and fill in your values

# --- Required: Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_MODE=telegram

# --- Required: Twitch (optional) ---
TWITCH_BOT_NICK=your_twitch_bot_name
TWITCH_BOT_TOKEN=your_twitch_oauth_token
TWITCH_CHANNEL=your_channel_name
TWITCH_OWNER=your_twitch_username
TWITCH_ADMIN_USERS=mod1,mod2
TWITCH_CLIENT_ID=your_twitch_application_client_id
TWITCH_CLIENT_SECRET=your_twitch_application_client_secret
TWITCH_REFRESH_TOKEN=
TWITCH_BOT_USER_ID=
TWITCH_BROADCASTER_ID=
TWITCH_AUTO_REPLY=false
TWITCH_REQUIRE_MOD_SCOPES=true

STREAM_SCHEDULE=your_stream_schedule
STREAM_TODAY_FALLBACK=Heute ist kein fixer Stream eingetragen. Follow fuer den Ping.
TWITCH_CHANNEL_URL=your_twitch_channel_url
YOUTUBE_URL=
CLIP_INTAKE_URL=your_clip_intake_url

# --- Required: Ollama ---
OLLAMA_PRIMARY_URL=your_ollama_primary_url
OLLAMA_SECONDARY_URL=your_ollama_fallback_url
OLLAMA_FALLBACK_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4
OLLAMA_FALLBACK_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60
OLLAMA_NUM_PREDICT=400
OLLAMA_TEMPERATURE=0.7

# --- Optional: Admin ---
ADMIN_IDS=123456789,987654321

# --- Optional: Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional: Tailscale (Docker) ---
TS_AUTHKEY=tskey-your-auth-key

# --- Optional: Bot ---
MAX_HISTORY=20
RATE_LIMIT=10
LOG_LEVEL=INFO
